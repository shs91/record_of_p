        android:scaleX="0.62"
        android:scaleY="0.62"
        android:pivotX="62"
        android:pivotY="59"
        android:translateX="-2"
        android:translateY="1">
        <!-- 링 헤드: 바깥 r26 / 구멍 r10 (evenOdd) -->
