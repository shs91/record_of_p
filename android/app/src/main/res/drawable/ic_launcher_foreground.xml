            android:pathData="M66,18 a26,26 0 1,1 0,52 a26,26 0 1,1 0,-52 Z M66,34 a10,10 0 1,1 0,20 a10,10 0 1,1 0,-20 Z" />
        <!-- 스템: 위 8r 라운드 캡, 아래로 테이퍼 -->
