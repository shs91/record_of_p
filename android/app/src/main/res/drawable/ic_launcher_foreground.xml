     뾰족한 스템(핀의 바늘). 블루 바탕(@color/ic_launcher_background) 위 흰 마크. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
